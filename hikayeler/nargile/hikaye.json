 "cumleler": [
  {
   "id": "C01",
   "adim": "kanca",
   "metin": "Caminin tam ortasında nargile içiyordu, üstelik içinde tütün yoktu.",
   "vurgu": [
    "tütün",
    "nargile"
   ]
  },
  {
   "id": "C02",
   "adim": "kurulum",
   "metin": "Rivayete göre bu adam, başmimar Sinan'dı.",
   "vurgu": [
    "Sinan"
   ]
  },
  {
   "id": "C03",
   "adim": "kurulum",
   "metin": "Süleymaniye yedi yıldır sürüyordu ve padişahın sabrı tükenmişti.",
   "vurgu": [
    "yedi"
   ]
  },
  {
   "id": "C04",
   "adim": "alay",
   "metin": "Onu gören vezir sırıttı: \"Cami yapmıyor, keyif yapıyor!\"",
   "vurgu": [
    "keyif"
   ]
  },
  {
   "id": "C05",
   "adim": "sakin",
   "metin": "Sinan dönüp bakmadı bile. Sadece kulağını kubbeye verdi.",
   "vurgu": [
    "kubbeye"
   ]
  },
  {
   "id": "C06",
   "adim": "tirmanis",
   "metin": "Vezir saraya koştu ve gördüğünü padişaha anlattı.",
   "vurgu": [
    "koştu"
   ]
  },
  {
   "id": "C07",
   "adim": "tirmanis",
   "metin": "Padişah kıpkırmızı kesildi ve doğruca inşaata yürüdü.",
   "vurgu": [
    "kıpkırmızı"
   ]
  },
  {
   "id": "C08",
   "adim": "tirmanis",
   "metin": "Ama içeri girdiğinde Sinan daha da tuhaf davranıyordu.",
   "vurgu": [
    "tuhaf"
   ]
  },
  {
   "id": "C09",
   "adim": "tirmanis",
   "metin": "Nargileyi köşeden köşeye taşıyor, fokurdatıyor, sonra susup bekliyordu.",
   "vurgu": [
    "susup"
   ]
  },
  {
   "id": "C10",
   "adim": "tirmanis",
   "metin": "Vezir bağırdı: \"İşte suçüstü!\" Sinan ise nargileyi padişaha uzattı.",
   "vurgu": [
    "suçüstü"
   ]
  },
  {
   "id": "C11",
   "adim": "tirmanis",
   "metin": "Padişah eğilip kokladı. Ne duman vardı ne tütün.",
   "vurgu": [
    "Ne"
   ]
  },
  {
   "id": "C12",
   "adim": "sir",
   "metin": "İşin sırrı şu: Sinan fokurtunun nereye kadar gittiğini dinliyordu.",
   "vurgu": [
    "sırrı"
   ]
  },
  {
   "id": "C13",
   "adim": "sir",
   "metin": "Hamamda şarkı söylersen sesin uğuldar; dev kubbe de aynısını yapar.",
   "vurgu": [
    "uğuldar"
   ]
  },
  {
   "id": "C14",
   "adim": "sir",
   "metin": "Bu yüzden kubbeye, ağzı içeri açılan toprak küpler gömüldü.",
   "vurgu": [
    "küpler"
   ]
  },
  {
   "id": "C15",
   "adim": "sir",
   "metin": "Küpler uğultuyu yutmak içindi. Söz ise berrak kalacaktı.",
   "vurgu": [
    "yutmak"
   ]
  },
  {
   "id": "C16",
   "adim": "final",
   "metin": "Sinan salonun en ucuna yürüdü ve bir şey fısıldadı.",
   "vurgu": [
    "fısıldadı"
   ]
  },
